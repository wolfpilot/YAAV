{
  "name": "YAAV",
  "description": "Yet Another Audio Visualizer. Build with Parcel & JS Canvas.",
  "version": "0.0.0",
  "author": "Razvan Negrea <howl@wolfpilot.co> (www.wolfpilot.co)",
  "license": "MIT",
  "scripts": {
    "prebuild": "rimraf dist",
    "start": "pnpm dev",
    "dev": "parcel -p 3000 ./src/index.html",
    "typecheck": "tsc --noEmit",
    "build": "parcel build ./src/index.html --public-url /YAAV/",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist"
  },
  "keywords": [
    "javascript",
    "parcel",
    "canvas",
    "audio",
    "visualization"
  ],
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "parcel": "^2.16.4",
    "prettier": "^3.9.10",
    "rimraf": "6.1.4",
    "typescript": "^7.0.2"
  }
}
